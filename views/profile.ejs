<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <div class="container">
            <section class="profile-header">
                <img class="profile-avatar" src="<%= profileUser.profileImage %>" alt="תמונת פרופיל">
                <div class="profile-meta">
                    <h1 class="profile-name"><%= profileUser.fullName %></h1>
                    <p class="profile-username">@<%= profileUser.username %></p>
                    <% if (profileUser.city) { %>
                        <p class="profile-city"><%= profileUser.city %></p>
                    <% } %>
                    <% if (profileUser.bio) { %>
                        <p class="profile-bio"><%= profileUser.bio %></p>
                    <% } %>
                    <% if (isOwn) { %>
                        <a class="btn btn-outline-brand btn-sm profile-edit-btn" href="/profile/edit">עריכת פרופיל</a>
                    <% } else { %>
                        <button class="btn btn-sm profile-edit-btn friend-toggle <%= isFriend ? 'btn-outline-brand' : 'btn-brand' %>"
                                data-user-id="<%= profileUser._id %>"
                                data-is-friend="<%= isFriend %>">
                            <%= isFriend ? 'הסרה מחברים' : 'הוספה כחבר' %>
                        </button>
                    <% } %>
                </div>
            </section>
            <div class="row g-4">
                <aside class="col-md-4">
                    <div class="stat-card">
                        <span class="stat-value"><%= profileUser.monthlyGoalKm %></span>
                        <span class="stat-label">יעד חודשי (ק"מ)</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-value" id="friendCount"><%= profileUser.friends.length %></span>
                        <span class="stat-label">חברים</span>
                    </div>
                    <% if (profileUser.friends.length) { %>
                        <div class="stat-card friend-list">
                            <span class="stat-label">רשימת חברים</span>
                            <ul>
                                <% profileUser.friends.forEach(function (f) { %>
                                    <li><a href="/users/<%= f._id %>"><%= f.fullName %></a></li>
                                <% }); %>
                            </ul>
                        </div>
                    <% } %>
                </aside>
                <section class="col-md-8">
                    <h2 class="section-title"><%= isOwn ? 'הפוסטים שלי' : 'הפוסטים של ' + profileUser.fullName %></h2>
                    <% if (!posts.length) { %>
                        <p class="empty-state">עדיין אין פוסטים.</p>
                    <% } else { %>
                        <% posts.forEach(function (post) { %>
                            <%- include('partials/post-card', { post: post }) %>
                        <% }); %>
                        <% if (isOwn && total > posts.length) { %>
                            <a class="btn btn-outline-brand btn-sm" href="/posts/mine">כל <%= total %> הפוסטים שלי</a>
                        <% } %>
                    <% } %>
                </section>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/friends.js"></script>
    <script src="/js/posts.js"></script>
    <script src="/js/share.js"></script>
</body>
</html>