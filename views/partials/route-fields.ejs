<div class="mb-3">
    <label class="form-label" for="name">שם המסלול</label>
    <input class="form-control" type="text" id="name" name="name"
           value="<%= values.name || '' %>" required minlength="2" maxlength="80">
</div>
<div class="row g-2 mb-3">
    <div class="col-md-8">
        <label class="form-label" for="address">כתובת נקודת ההתחלה</label>
        <input class="form-control" type="text" id="address" name="address"
               value="<%= values.address || '' %>" required maxlength="200">
    </div>
    <div class="col-md-4">
        <label class="form-label" for="city">עיר</label>
        <input class="form-control" type="text" id="city" name="city"
               value="<%= values.city || '' %>" maxlength="40">
    </div>
</div>
<div class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label" for="lat">קו רוחב</label>
        <input class="form-control" type="number" id="lat" name="lat"
               value="<%= values.lat === undefined ? '' : values.lat %>" required min="-90" max="90" step="any">
    </div>
    <div class="col-md-3">
        <label class="form-label" for="lng">קו אורך</label>
        <input class="form-control" type="number" id="lng" name="lng"
               value="<%= values.lng === undefined ? '' : values.lng %>" required min="-180" max="180" step="any">
    </div>
    <div class="col-md-3">
        <label class="form-label" for="distanceKm">אורך (ק"מ)</label>
        <input class="form-control" type="number" id="distanceKm" name="distanceKm"
               value="<%= values.distanceKm === undefined ? '' : values.distanceKm %>" required min="0.1" max="500" step="0.1">
    </div>
    <div class="col-md-3">
        <label class="form-label" for="difficulty">רמת קושי</label>
        <select class="form-control" id="difficulty" name="difficulty" required>
            <option value="">בחרו</option>
            <option value="easy" <%= values.difficulty === 'easy' ? 'selected' : '' %>>קל</option>
            <option value="medium" <%= values.difficulty === 'medium' ? 'selected' : '' %>>בינוני</option>
            <option value="hard" <%= values.difficulty === 'hard' ? 'selected' : '' %>>קשה</option>
        </select>
    </div>
</div>
<div class="mb-4">
    <label class="form-label" for="description">תיאור</label>
    <textarea class="form-control" id="description" name="description" rows="3"
              maxlength="500"><%= values.description || '' %></textarea>
</div>