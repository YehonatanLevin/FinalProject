<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <div class="container">
            <div class="feed-head">
                <h1 class="section-title">הפוסטים שלי (<%= total %>)</h1>
                <a class="btn btn-brand btn-sm" href="/posts/new">פוסט חדש</a>
            </div>

            <div class="row">
                <div class="col-lg-8">
                    <% if (!posts.length) { %>
                        <p class="empty-state">עדיין לא פרסמת פוסטים.</p>
                    <% } else { %>
                        <% posts.forEach(function (post) { %>
                            <%- include('partials/post-card', { post: post }) %>
                        <% }); %>

                        <%- include('partials/pagination') %>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/posts.js"></script>
    <script src="/js/share.js"></script>
</body>
</html>
