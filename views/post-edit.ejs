<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <div class="container">
            <section class="form-card">

                <h1 class="form-title">עריכת פוסט</h1>

                <% if (errors.length) { %>
                    <div class="alert alert-danger" role="alert">
                        <ul class="error-list">
                            <% errors.forEach(function (e) { %>
                                <li><%= e %></li>
                            <% }); %>
                        </ul>
                    </div>
                <% } %>

                <form action="/posts/<%= post._id %>/edit" method="POST" novalidate>

                    <div class="mb-3">
                        <label class="form-label" for="content">תוכן</label>
                        <textarea
                            class="form-control"
                            id="content"
                            name="content"
                            rows="4"
                            maxlength="1000"
                            required><%= post.content %></textarea>
                    </div>

                    <% if (post.type === 'run') { %>
                        <div class="row g-2 mb-3">

                            <div class="col-6">
                                <label class="form-label" for="distanceKm">
                                    מרחק (ק"מ)
                                </label>

                                <input
                                    class="form-control"
                                    type="number"
                                    id="distanceKm"
                                    name="distanceKm"
                                    value="<%= post.run.distanceKm %>"
                                    min="0.1"
                                    max="500"
                                    step="0.1">
                            </div>

                            <div class="col-6">
                                <label class="form-label" for="durationMin">
                                    משך (דקות)
                                </label>

                                <input
                                    class="form-control"
                                    type="number"
                                    id="durationMin"
                                    name="durationMin"
                                    value="<%= post.run.durationMin %>"
                                    min="1"
                                    max="1440"
                                    step="1">
                            </div>

                        </div>
                    <% } %>

                    <button class="btn btn-brand w-100" type="submit">
                        שמירה
                    </button>

                </form>

                <p class="form-foot">
                    <a href="/posts/mine">חזרה לפוסטים שלי</a>
                </p>

            </section>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
