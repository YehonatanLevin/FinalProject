<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <div class="container">
            <h1 class="section-title">משתמשים</h1>

            <form class="search-bar" id="userSearchForm" action="/users" method="GET">
                <div class="row g-2">
                    <div class="col-md-5">
                        <label class="form-label" for="q">שם או שם משתמש</label>
                        <input class="form-control" type="text" id="q" name="q" value="<%= values.q %>" maxlength="40">
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="city">עיר</label>
                        <input class="form-control" type="text" id="city" name="city" value="<%= values.city %>" maxlength="40">
                    </div>
                    <div class="col-md-2 search-actions">
                        <button class="btn btn-brand w-100" type="submit">חיפוש</button>
                    </div>
                </div>
            </form>

            <div id="userResults">
                <%- include('partials/user-list', { users: users, friendIds: friendIds }) %>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/friends.js"></script>
    <script src="/js/user-search.js"></script>
</body>
</html>