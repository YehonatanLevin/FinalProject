<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <%- include('partials/head') %>
</head>
<body>

    <%- include('partials/header') %>

    <main>
        <div class="container">

            <section class="form-card form-card-wide">

                <h1 class="form-title">פוסט חדש</h1>

                <% if (errors.length) { %>
                    <div class="alert alert-danger" role="alert">
                        <ul class="error-list">
                            <% errors.forEach(function (e) { %>
                                <li><%= e %></li>
                            <% }); %>
                        </ul>
                    </div>
                <% } %>

                <form
                    action="/posts"
                    method="POST"
                    enctype="multipart/form-data"
                    id="postForm"
                    novalidate>

                    <div class="mb-3">

                        <span class="form-label">סוג הפוסט</span>

                        <div class="type-picker">

                            <label class="type-option">
                                <input
                                    type="radio"
                                    name="type"
                                    value="text"
                                    <%= values.type !== 'image' && values.type !== 'run' ? 'checked' : '' %>>

                                <span>טקסט</span>
                            </label>

                            <label class="type-option">
                                <input
                                    type="radio"
                                    name="type"
                                    value="image"
                                    <%= values.type === 'image' ? 'checked' : '' %>>

                                <span>טקסט ותמונה</span>
                            </label>

                            <label class="type-option">
                                <input
                                    type="radio"
                                    name="type"
                                    value="run"
                                    <%= values.type === 'run' ? 'checked' : '' %>>

                                <span>דיווח ריצה</span>
                            </label>

                        </div>
                    </div>


                    <div class="mb-3">

                        <label class="form-label" for="content">
                            תוכן
                        </label>

                        <textarea
                            class="form-control"
                            id="content"
                            name="content"
                            rows="4"
                            maxlength="1000"
                            required><%= values.content || '' %></textarea>

                        <small class="form-hint">
                            עד 1000 תווים
                        </small>

                    </div>


                    <div
                        class="mb-3 type-field"
                        data-for="image"
                        hidden>

                        <label class="form-label" for="image">
                            תמונה
                        </label>

                        <input
                            class="form-control"
                            type="file"
                            id="image"
                            name="image"
                            accept="image/jpeg,image/png,image/webp">

                        <small class="form-hint">
                            JPG, PNG או WEBP · עד 2MB
                        </small>

                    </div>


                    <div
                        class="type-field"
                        data-for="run"
                        hidden>

                        <div class="row g-2 mb-3">

                            <div class="col-md-4">

                                <label
                                    class="form-label"
                                    for="distanceKm">
                                    מרחק (ק"מ)
                                </label>

                                <input
                                    class="form-control"
                                    type="number"
                                    id="distanceKm"
                                    name="distanceKm"
                                    value="<%= values.distanceKm || '' %>"
                                    min="0.1"
                                    max="500"
                                    step="0.1">

                            </div>


                            <div class="col-md-4">

                                <label
                                    class="form-label"
                                    for="durationMin">
                                    משך (דקות)
                                </label>

                                <input
                                    class="form-control"
                                    type="number"
                                    id="durationMin"
                                    name="durationMin"
                                    value="<%= values.durationMin || '' %>"
                                    min="1"
                                    max="1440"
                                    step="1">

                            </div>


                            <div class="col-md-4">

                                <label
                                    class="form-label"
                                    for="route">
                                    מסלול
                                </label>

                                <select
                                    class="form-control"
                                    id="route"
                                    name="route">

                                    <option value="">
                                        ללא מסלול
                                    </option>

                                    <% routes.forEach(function (r) { %>
                                        <option
                                            value="<%= r._id %>"
                                            <%= String(values.route) === String(r._id) ? 'selected' : '' %>>

                                            <%= r.name %>
                                            (<%= r.distanceKm %> ק"מ)

                                        </option>
                                    <% }); %>

                                </select>

                            </div>

                        </div>

                    </div>


                    <div class="mb-4">

                        <label
                            class="form-label"
                            for="group">
                            פרסום בקבוצה
                        </label>

                        <select
                            class="form-control"
                            id="group"
                            name="group">

                            <option value="">
                                ללא קבוצה (פוסט אישי)
                            </option>

                            <% groups.forEach(function (g) { %>

                                <option
                                    value="<%= g._id %>"
                                    <%= String(values.group) === String(g._id) ? 'selected' : '' %>>

                                    <%= g.name %>

                                </option>

                            <% }); %>

                        </select>

                    </div>


                    <button
                        class="btn btn-brand w-100"
                        type="submit">
                        פרסום
                    </button>

                </form>


                <p class="form-foot">
                    <a href="/">חזרה לפיד</a>
                </p>

            </section>

        </div>
    </main>


    <%- include('partials/footer') %>

    <script src="/js/post-form.js"></script>

</body>
</html>
