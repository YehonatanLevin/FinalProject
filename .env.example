# העתיקו לקובץ .env ומלאו ערכים אמיתיים

# חיבור למסד הנתונים
MONGODB_URI=mongodb://127.0.0.1:27017/runtogether

# פורט השרת
PORT=3000

# Google Maps - Maps Demo Key (חינמי, ללא כרטיס אשראי)
# console.cloud.google.com/google/maps-hosted/tos
MAPS_API_KEY=

# מחרוזת אקראית לחתימת ה-session
SESSION_SECRET=change-me-to-a-long-random-string

# פייסבוק - Graph API. בלעדיהם השיתוף מחזיר 503 עם הודעה ברורה.
FB_PAGE_ID=
FB_ACCESS_TOKEN=
